<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.cuukenn</groupId>
        <artifactId>financial-calc-service</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>calc-server</artifactId>

    <name>calc-server</name>
    <description>Spring Boot thin shell exposing CalculationFacade as a JSON API</description>

    <dependencies>
        <!-- The engine brings calc-domain, calc-rule and calc-common transitively. -->
        <dependency>
            <groupId>io.github.cuukenn</groupId>
            <artifactId>calc-engine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- OpenAPI documentation (R78): version managed in calc-bom (springdoc 2.8.x, the
             Boot 3.5-compatible line, A6). Brings swagger-annotations for the DTO @Schema docs;
             serves OpenAPI 3.1 JSON (was 3.0.x on springdoc 1.x). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 可执行 fat jar 与 mvn spring-boot:run 的前提；版本与 calc-bom 的 spring-boot.version 保持一致（BOM 属性不随 import 传播，无法引用） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>2.7.18</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <!-- Docker 分层构建：jar 自带 layers.idx，layertools extract 拆出
                     dependencies / spring-boot-loader / snapshot-dependencies / application 四层，
                     依赖不变的重建只动 application 层（见 docker/backend.Dockerfile）。
                     2.4+ 默认开启，这里显式钉住。 -->
                <configuration>
                    <layers>
                        <enabled>true</enabled>
                    </layers>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
