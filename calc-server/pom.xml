<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.cuukenn</groupId>
        <artifactId>financial-calc-service</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>calc-server</artifactId>

    <name>calc-server</name>
    <description>Spring Boot thin shell exposing CalculationFacade as a JSON API</description>

    <dependencies>
        <!-- The engine brings calc-domain, calc-rule and calc-common transitively. -->
        <dependency>
            <groupId>io.github.cuukenn</groupId>
            <artifactId>calc-engine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- OpenAPI documentation (R78): version managed in calc-bom (springdoc 1.7.x, the
             Boot 2.7-compatible line). Brings swagger-annotations for the DTO @Schema docs. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
